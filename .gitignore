__pycache__/
*.pyc
.venv/
.env
.fetch_cache/
*.egg-info/
.DS_Store
# Preview briefs (run_brief.py --preview) are mid-week throwaway outputs.
briefs/*-preview/
# Throwaway design mocks / scratch previews shared between the two chats.
# Never published; reproducible from the scripts inside.
scratch/
# Claude Code editor-side bookkeeping (worktree gitlinks break Pages
# checkout because they look like submodules without a .gitmodules entry).
.claude/
# Internal docs: strategy, sponsor pipeline, handovers, decision log.
# The repo is PUBLIC; committing these would publish the business side
# (sponsor targets, pricing) to the people it is about. Interim guard
# until the platform chat decides the public/private doc structure
# (research/handover_platform.md, first tasks). NOTE: fires/ is NOT
# ignored; it must be committed for the 2026-08-03 launch.
research/
# Also without the trailing slash, which is NOT redundant. A worktree
# gets research/ as a SYMLINK to the main tree (see CLAUDE.md), and git
# treats a symlink as a file, so the directory pattern above does not
# match it. Without this line every worktree reports `?? research` and
# would eventually commit the link into this PUBLIC repo, publishing a
# path into the private one and breaking for anyone who cloned it.
research
.publish-check/
.fast-reaction-preview/

# Cross-chat notice board for long unattended jobs (CLAUDE.md working
# style). Local coordination only; never belongs in a commit.
.running-jobs

# Raw gridded captures. These belong in the GitHub Release store, not in
# git history. Floods' capture workflow already uploads .npz to the
# `vcdwd-capture` release and commits only the manifest; this rule stops
# a local run from committing the payload as well.
#
# The gap was mine: the release store shipped without this line, and a
# 20.7 MB IMERG grid landed in a local commit on 2026-07-29, against a
# .git of 51 MB. Git history cannot be trimmed without a force-push, and
# force-pushing this repo is barred by the immutable-archive invariant,
# so the only cheap moment to catch one of these is before it is pushed.
*.npz
*.npy

# Built pages belong in docs/, never copied here. A snapshot of the real
# output drifts the moment either side changes, and 22 of them had already
# drifted by the time platform found them in a 38,280-line diff.
design/review/heat/

# Design's local heat preview: build output, never served (not under
# docs/), regenerable by design/preview_sync.py. It reached the repo
# through an add -A and its 74 tracked files then showed as modified in
# every chat's git status, which is how it blocked CRO's auto-push on
# 2026-08-09: a rebase refuses while they are dirty, so one chat's
# preview directory could stop another chat's commit reaching origin.
heat-preview/
